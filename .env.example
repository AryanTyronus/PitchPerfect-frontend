# Root environment reference for PitchPerfect.
# Copy the relevant values into `backend/.env` and `frontend/.env`.

# Backend
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=whisper-large-v3
LLM_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=openai/whisper-1
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_or_anon_key
API_TOKEN=replace_with_a_local_api_token
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PORT=8000

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_USE_MOCK_API=false
VITE_API_TOKEN=replace_with_the_backend_api_token
