# Frontend Environment Variables
# Copy this file to `.env` in the frontend directory for local development.
# NEVER commit the actual `.env` file.

# Base URL of the FastAPI backend for API calls. Leave empty in local dev so
# requests use relative paths (/api/v1/...) and flow through the Vite dev
# proxy (see vite.config.ts). Set it for production, e.g.:
#   VITE_API_URL=https://your-backend.example.com
VITE_API_URL=

# WS origin for the real-time audio stream. Leave empty in local dev so the
# client derives ws(s)://<current-host> and uses the Vite /ws proxy. Set it for
# production, e.g.:
#   VITE_WS_URL=wss://your-backend.example.com
VITE_WS_URL=

# When "false", the app talks to the real backend instead of the mock API.
VITE_USE_MOCK_API=false

# Optional: mirror the backend's API_TOKEN here so requests are sent with
# "Authorization: Bearer <token>". Only needed if the backend enforces tokens.
VITE_API_TOKEN=
