# Backend Environment Variables
# Copy this file to `.env` in the backend directory and fill in with real values.
# NEVER commit the actual `.env` file with real credentials.

# Groq API Key for AI services
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter API Configuration
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_STT_MODEL=groq/whisper-large-v3
OPENROUTER_LLM_MODEL=openai/gpt-4o-mini

# Supabase Configuration
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_api_key_here

# Server Configuration
PORT=8000
